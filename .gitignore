.DS_Store
__pycache__/
*.pyc

# Mirror of the Dropbox game folder written by game_sync.py (rosters, map
# bundles, trains, car inventories). The game's data, never committed here;
# it carries its OWN private git repo so successive syncs can be diffed.
game_data/

# Legacy hand-copied drop-in folder for rosters (pre game_sync.py). Not ours
# to redistribute, never committed.
TSARs/

# Game screenshots used to transcribe the map-ID -> name table into
# locations.csv. Input only; the transcription is what gets committed.
map_id_screenshots/

# docs/ and locations.csv are deliberately committed: GitHub Pages serves the
# built page from docs/, and the location name store has to persist across
# TSAR updates or hand-entered names would be lost.

# Per-yard game file bundles (map, sorts, live cars) shared for format
# exploration. Game data plus personal player state; never committed.
sample_yard_data/

# Community-made state connection diagrams (Robert Verheus). Reference
# material for transcription, not ours to redistribute.
connections/
